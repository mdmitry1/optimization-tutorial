#!/usr/bin/tcsh -f

# Copyright (C) 2025-2026 Dmitry Messerman
# SPDX-License-Identifier: GPL-3.0

set script_path=`realpath $0 | xargs dirname`
set dist=$script_path:h/dist
\rm -rf $dist >& /dev/null
pip -v wheel $script_path:h --no-deps -w $dist
if($status) then
    echo "\nERROR: build failed\n"
    exit 1
else
    if($#argv > 0) then
        if("-test" == "$argv[1]") then
            twine upload --repository testpypi $dist/*whl
            exit($status)
        endif 
    endif
    twine upload $dist/*whl
endif
